MENSAJERO_URL=http://127.0.0.1:8000
MENSAJERO_CLAVE_CONEXION=recolector-pruebas
MENSAJERO_PASARELA_SECRETO=
RECOLECTOR_RUTA_DATOS=./datos
# Debe apuntar a la misma raíz privada física que MENSAJERO_RUTA_ALMACENAMIENTO en Laravel.
# En producción conviene definir ambas explícitamente con la misma ubicación de almacenamiento.
# Vacío usa ../storage/app/mensajero durante el POC local.
# Si esta variable se define temporalmente en PowerShell, recuerde que permanece activa en esa sesión
# y cualquier proceso iniciado desde ella heredará ese valor hasta eliminarlo o cerrar la consola.
RECOLECTOR_RUTA_ALMACENAMIENTO=
RECOLECTOR_INTERVALO_AUTORIZACIONES_MS=15000
RECOLECTOR_INTERVALO_GRUPOS_MS=300000
RECOLECTOR_INTERVALO_COLA_MS=2000
RECOLECTOR_MAX_REINTENTO_MS=60000
RECOLECTOR_INTERVALO_LATIDO_MS=30000
NIVEL_REGISTRO=info
