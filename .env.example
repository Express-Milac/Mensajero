APP_NAME=Mensajero
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Temporalmente Mensajero funciona sin inicio de sesión.
# corporativo queda reservado para la futura integración de identidad MILAC y falla cerrado.
MENSAJERO_MODO_AUTENTICACION=deshabilitado

# Base SQL Server corporativa existente. No crear una base separada para Mensajero.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=mensajero:

# Los archivos se guardan fuera de SQL Server. Vacío usa almacenamiento local del proyecto.
FILESYSTEM_DISK=mensajero_local
MENSAJERO_RUTA_ALMACENAMIENTO=
MENSAJERO_BYTES_LIBRES_MINIMOS=1073741824

# Pasarela autohospedada por MILAC; no se usa SaaS para capturar WhatsApp.
# El secreto debe tener al menos 32 caracteres aleatorios y compartirse solo entre Laravel y la pasarela.
PROVEEDOR_WHATSAPP=web_autohospedado
WHATSAPP_PASARELA_URL=
WHATSAPP_PASARELA_SECRETO=
MENSAJERO_VENTANA_FIRMA_SEGUNDOS=300

CLAVE_API_GEMINI=
MODELO_GEMINI=
IA_HABILITADA=false

BROADCAST_CONNECTION=log
MAIL_MAILER=log
