APP_NAME=Mensajero
APP_ENV=production
APP_KEY=
APP_DEBUG=false
### Sustituir por la URL HTTPS interna aprobada antes de usar en servidor.
APP_URL=https://mensajero.example.invalid
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning

# En servidor se exige autenticacion corporativa; todavia NO esta integrada.
# El modo corporativo falla cerrado (503) hasta que el instalador integre
# identidad MILAC o un control de acceso validado. No cambiar a deshabilitado
# para desbloquear pantallas en un servidor compartido.
MENSAJERO_MODO_AUTENTICACION=corporativo
# Solo para POC en localhost: ver mensajes reales sin iniciar sesión.
# Mantener false en redes compartidas y servidores expuestos.
MENSAJERO_CONSULTA_LOCAL_SIN_AUTENTICACION=false
# Habilitar temporalmente SOLO en desarrollo, localhost, si se necesita
# mostrar/ocultar grupos en el tablero antes de integrar el login.
# No autoriza cambiar la captura y no funciona por red.
MENSAJERO_GESTION_LOCAL_GRUPOS_HABILITADA=false
# Identificación manual de remitentes, independiente del gestor de grupos.
# Activar solo en localhost para pruebas sin login; no modificar mensajes crudos.
MENSAJERO_GESTION_LOCAL_REMITENTES_HABILITADA=false

# Base SQL Server corporativa existente. No crear una base separada para Mensajero.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

# Las sesiones y la caché no deben depender del servidor Redis de las colas.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
# Redis se utiliza exclusivamente para los trabajos asíncronos de Mensajero.
QUEUE_CONNECTION=redis
# Normalización desactivada hasta aprobar las pruebas SQL Server.
MENSAJERO_NORMALIZACION_HABILITADA=false
MENSAJERO_COLA_NORMALIZACION=mensajero_normalizacion
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# El instalador debe reemplazar este prefijo por uno exclusivo de la instancia.
# No usar el mismo prefijo que otros servicios u otros entornos.
REDIS_PREFIX=mensajero_instancia_pendiente:

# Los archivos se guardan fuera de SQL Server. Vacío usa almacenamiento local del proyecto.
FILESYSTEM_DISK=mensajero_local
MENSAJERO_RUTA_ALMACENAMIENTO=
MENSAJERO_BYTES_LIBRES_MINIMOS=1073741824

# Integración oficial directa con Meta / WhatsApp Business Platform Cloud API.
PROVEEDOR_WHATSAPP=meta_cloud_api
META_WHATSAPP_GRAPH_VERSION=v26.0
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=

# Canal interno firmado reservado para integraciones entre servicios MILAC.
WHATSAPP_PASARELA_URL=
WHATSAPP_PASARELA_SECRETO=
MENSAJERO_VENTANA_FIRMA_SEGUNDOS=300

CLAVE_API_GEMINI=
MODELO_GEMINI=
IA_HABILITADA=false
MENSAJERO_IA_ENVIO_AUTORIZADO=false
MENSAJERO_IA_SERVICIO_PAGADO_CONFIRMADO=false
MENSAJERO_IA_LOTES_HABILITADOS=false
MENSAJERO_IA_EJECUCION_AUTOMATICA=false
MENSAJERO_IA_CONCILIACION_AUTOMATICA=false
MENSAJERO_TIEMPO_REAL_HABILITADO=false

BROADCAST_CONNECTION=log
MAIL_MAILER=log
