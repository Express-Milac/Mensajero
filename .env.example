APP_NAME=Mensajero
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
# Presentación; la persistencia operativa usa UTC.
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Temporalmente Mensajero funciona sin login. Cambiar a local solo para desarrollo.
# corporate queda reservado para la futura integración de identidad MILAC y falla cerrado.
MENSAJERO_AUTH_MODE=disabled

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
# Base corporativa existente. No crear una BD separada desde esta plantilla.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=mensajero:

FILESYSTEM_DISK=mensajero_local
MENSAJERO_STORAGE_PATH=
MENSAJERO_MIN_FREE_BYTES=1073741824

# Gateway autohospedado por MILAC. No usar SaaS/proveedores administrados.
WHATSAPP_PROVIDER=self_hosted_web
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=false

BROADCAST_CONNECTION=log
MAIL_MAILER=log
