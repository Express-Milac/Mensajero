APP_NAME=Mensajero
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Temporalmente Mensajero funciona sin inicio de sesión.
# corporativo queda reservado para la futura integración de identidad MILAC y falla cerrado.
MENSAJERO_MODO_AUTENTICACION=deshabilitado
# Solo para POC en localhost: ver mensajes reales sin iniciar sesión.
# Mantener false en redes compartidas y servidores expuestos.
MENSAJERO_CONSULTA_LOCAL_SIN_AUTENTICACION=false
# Habilitar temporalmente SOLO en desarrollo localhost para activar o
# desactivar simultaneamente la captura y la vista de los grupos.
# La gestion cambia autorizaciones reales: no utilizar en servidores expuestos.
MENSAJERO_GESTION_LOCAL_GRUPOS_HABILITADA=false
# Identificación manual de remitentes, independiente del gestor de grupos.
# Activar solo en localhost para pruebas sin login; no modificar mensajes crudos.
MENSAJERO_GESTION_LOCAL_REMITENTES_HABILITADA=false

# Base SQL Server corporativa existente. No crear una base separada para Mensajero.
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

# Las sesiones y la caché no deben depender del servidor Redis de las colas.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# Redis se utiliza exclusivamente para los trabajos asíncronos de Mensajero.
QUEUE_CONNECTION=redis
# Normalización desactivada hasta aprobar las pruebas SQL Server.
MENSAJERO_NORMALIZACION_HABILITADA=false
MENSAJERO_COLA_NORMALIZACION=mensajero_normalizacion
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Definir un prefijo exclusivo para pruebas o producción en cada instalación.
REDIS_PREFIX=mensajero:

# Canal SSE para avisos en vivo. En desarrollo se sirve desde el recolector
# en 127.0.0.1:8765. No expone texto ni teléfonos: el tablero sigue consultando Laravel.
# En producción publicar mediante un proxy HTTPS con autorización vigente.
MENSAJERO_TIEMPO_REAL_HABILITADO=false
MENSAJERO_TIEMPO_REAL_PUERTO=8765
MENSAJERO_TIEMPO_REAL_URL=http://127.0.0.1:8765

# Los archivos se guardan fuera de SQL Server. Vacío usa almacenamiento local del proyecto.
FILESYSTEM_DISK=mensajero_local
MENSAJERO_RUTA_ALMACENAMIENTO=
MENSAJERO_BYTES_LIBRES_MINIMOS=1073741824

# Integración oficial directa con Meta / WhatsApp Business Platform Cloud API.
PROVEEDOR_WHATSAPP=meta_cloud_api
META_WHATSAPP_GRAPH_VERSION=v26.0
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_PHONE_NUMBER_ID=

# Canal interno firmado reservado para integraciones entre servicios MILAC.
WHATSAPP_PASARELA_URL=
WHATSAPP_PASARELA_SECRETO=
MENSAJERO_VENTANA_FIRMA_SEGUNDOS=300

# GEMINI FASE 2: prueba real validada el 22/10/2026, sin certificacion 24x7.
# Este EJEMPLO permanece apagado por seguridad. Para activarlo de forma persistente,
# usar scripts/activar-gemini.ps1 en la instalacion local (nunca guardar clave en Git).
# Requiere permiso para cada grupo, facturacion aprobada y condiciones de privacidad.
# Google comparte cuota a nivel de proyecto: preferir credenciales de proyecto dedicado.
# Guia: docs/operacion-gemini-permanente.md
CLAVE_API_GEMINI=
MODELO_GEMINI=gemini-3.5-flash-lite
IA_HABILITADA=false
MENSAJERO_IA_ENVIO_AUTORIZADO=false
MENSAJERO_IA_SERVICIO_PAGADO_CONFIRMADO=false
MENSAJERO_IA_GRUPOS_AUTORIZADOS=
# Solo mensajes recibidos DESPUÉS de esta fecha ISO-8601. Sin fecha, no sale nada.
MENSAJERO_IA_FECHA_INICIO=
MENSAJERO_COLA_IA=mensajero_ia
MENSAJERO_IA_EJECUCION_AUTOMATICA=false
# Piloto y operacion continua: enviar solo el texto objetivo, nunca el historial por defecto.
MENSAJERO_IA_SOLO_MENSAJE_OBJETIVO=true

BROADCAST_CONNECTION=log
MAIL_MAILER=log
