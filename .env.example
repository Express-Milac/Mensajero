APP_NAME=Mensajero
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
# Presentation only; persistence uses UTC.
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=mensajero
DB_USERNAME=mensajero_app
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FILESYSTEM_DISK=mensajero_local
MENSAJERO_STORAGE_PATH=
MENSAJERO_MIN_FREE_BYTES=1073741824
WHATSAPP_PROVIDER=unconfigured
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ENABLED=false
BROADCAST_CONNECTION=log
MAIL_MAILER=log
