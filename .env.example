APP_NAME=Mensajero
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_TIMEZONE=America/Mexico_City
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Temporalmente no existe login. El modo corporativo queda preparado y falla cerrado.
MENSAJERO_MODO_AUTENTICACION=deshabilitado
# IP exactas autorizadas para acciones administrativas mientras no exista login.
MENSAJERO_IPS_ADMINISTRACION=127.0.0.1,::1

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
# Base corporativa existente. No crear una base separada desde esta plantilla.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=file
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=mensajero:

FILESYSTEM_DISK=mensajero_local
MENSAJERO_RUTA_ALMACENAMIENTO=
MENSAJERO_BYTES_LIBRES_MINIMOS=1073741824

# Puerta de enlace autohospedada por MILAC.
MENSAJERO_PROVEEDOR_WHATSAPP=web_autohospedado
MENSAJERO_URL_PUERTA_ENLACE_WHATSAPP=
MENSAJERO_SECRETO_PUERTA_ENLACE_WHATSAPP=

GEMINI_CLAVE_API=
GEMINI_MODELO=
IA_HABILITADA=false

BROADCAST_CONNECTION=log
MAIL_MAILER=log
